# Public browser settings. Use a publishable key or legacy anon key.
# Never put a Supabase secret/service-role key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy aliases also supported: VITE_SUPABASE_ANON_KEY, VITE_SUPABASE_KEY
# Optional roster-season override, for example an existing season in your data:
VITE_NBA_SEASON=

# Optional server-only overrides; otherwise the public browser data settings are used.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Never use a service-role key for this API.

# Optional existing DeepSeek explanation service. Never prefix these with VITE_.
# Set DEEPSEEK_MODEL to a model currently available in your provider account.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
